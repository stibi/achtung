{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "root": ".." },
  "files": { "includes": ["**", "!reports", "!coverage", "!.stryker-tmp"] },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 12 }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": { "maxLines": 60, "skipBlankLines": true }
        }
      },
      "style": {
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": { "maxLines": 300, "skipBlankLines": true }
        },
        "noNonNullAssertion": "error",
        "noDefaultExport": "error",
        "noParameterAssign": "error",
        "noNestedTernary": "error",
        "noProcessEnv": "error",
        "useImportType": "error",
        "useExportType": "error",
        "useNodejsImportProtocol": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": { "filenameCases": ["kebab-case"] }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "error",
        "noTsIgnore": "error",
        "noEvolvingTypes": "error",
        "noImportCycles": "error",
        "noSkippedTests": "error",
        "noFocusedTests": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      },
      "performance": {
        "noReExportAll": "error",
        "noNamespaceImport": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/config.ts"],
      "linter": { "rules": { "style": { "noProcessEnv": "off" } } }
    },
    {
      "includes": ["*.config.ts", "*.config.mjs", "*.cjs"],
      "linter": { "rules": { "style": { "noDefaultExport": "off" } } }
    },
    {
      "includes": ["test/**"],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveLinesPerFunction": "off" },
          "style": { "noNonNullAssertion": "off" }
        }
      }
    }
  ]
}

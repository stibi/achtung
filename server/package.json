{
  "name": "@achtung/server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run arch && pnpm run migrations && pnpm run deadcode && pnpm run dupes && pnpm run test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "fix": "biome check --write .",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "deadcode": "knip",
    "dupes": "jscpd src",
    "migrations": "scripts/check-migrations.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:mutation": "stryker run",
    "db:generate": "drizzle-kit generate",
    "api:generate": "vitest run test/http/openapi.test.ts --update"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.6.0",
    "drizzle-kit": "^0.31.11",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "openapi-types": "^12.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}

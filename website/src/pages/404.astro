---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" description="This page doesn't exist." noindex>
  <section class="section not-found" aria-labelledby="not-found-title">
    <div class="container">
      <p class="eyebrow"><span class="beacon" aria-hidden="true"></span>404</p>
      <h1 id="not-found-title">Nothing firing here</h1>
      <p class="section-lead">This page doesn't exist. Maybe it resolved.</p>
      <div class="actions"><a class="button primary" href="/">Back to the inbox</a></div>
    </div>
  </section>
</Base>
